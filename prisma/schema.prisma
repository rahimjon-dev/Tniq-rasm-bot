generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  IMAGE
  VIDEO
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlanType {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model User {
  id           String        @id @default(uuid())
  telegramId   BigInt        @unique
  username     String?
  firstName    String?
  languageCode String?       @default("en")
  isBanned     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  jobs         MediaJob[]
  subscription Subscription?
  usages       Usage[]
  payments     Payment[]

  @@index([telegramId])
}

model MediaJob {
  id               String     @id @default(uuid())
  userId           String
  type             JobType
  status           JobStatus  @default(PENDING)
  scale            Int        @default(2)
  targetResolution String?    // e.g. "1080p", "4K", "original"
  inputResolution  String?    // e.g. "720x480"
  outputResolution String?    // e.g. "2880x1920"
  inputSize        BigInt?    // in bytes
  outputSize       BigInt?    // in bytes
  processingTime   Float?     // in seconds
  errorMessage     String?
  createdAt        DateTime   @default(now())
  completedAt      DateTime?

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  plan      PlanType           @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id        String   @id @default(uuid())
  userId    String
  date      String   // Format: YYYY-MM-DD
  imageJobs Int      @default(0)
  videoJobs Int      @default(0)
  totalJobs Int      @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  provider      String        // e.g. "telegram_stars", "payme", "click"
  transactionId String        @unique
  amount        Float
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  metadata      String?       // JSON string for provider payload
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Admin {
  id         String    @id @default(uuid())
  telegramId BigInt    @unique
  role       AdminRole @default(ADMIN)
  createdAt  DateTime  @default(now())
}
