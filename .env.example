# ==============================================================================
# AI MEDIA UPSCALER TELEGRAM BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT
# ------------------------------------------------------------------------------
# Get your token from Telegram @BotFather: https://t.me/BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_example

# Admin Telegram IDs (comma-separated integers)
ADMIN_TELEGRAM_IDS=7534175269

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL + PRISMA)
# ------------------------------------------------------------------------------
# Example for local docker: postgresql://postgres:postgres@localhost:5432/ai_upscaler?schema=public
# Example for cloud (Supabase / Neon): postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_upscaler?schema=public

# ------------------------------------------------------------------------------
# 4. REDIS & QUEUE (BULLMQ)
# ------------------------------------------------------------------------------
# Example for local redis: redis://localhost:6379
# Example for Upstash cloud: rediss://default:token@region.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. STORAGE & PATHS
# ------------------------------------------------------------------------------
STORAGE_TEMP_DIR=storage/temp
STORAGE_OUTPUT_DIR=storage/outputs

# ------------------------------------------------------------------------------
# 6. LIMITS & QUOTAS
# ------------------------------------------------------------------------------
FREE_DAILY_IMAGE_LIMIT=2
FREE_DAILY_VIDEO_LIMIT=1
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=30

# ------------------------------------------------------------------------------
# 7. AI ENGINE & PROVIDERS
# ------------------------------------------------------------------------------
# Supported image providers: real-esrgan-local | replicate | runware
AI_IMAGE_PROVIDER=real-esrgan-local

# Supported video providers: real-esrgan-video-local | replicate-video
AI_VIDEO_PROVIDER=real-esrgan-video-local

# Optional Cloud AI API Tokens (if using cloud providers):
REPLICATE_API_TOKEN=
RUNWARE_API_KEY=

# Local Real-ESRGAN binary path (relative or absolute)
REAL_ESRGAN_PATH=./realesrgan/realesrgan-ncnn-vulkan.exe
REAL_ESRGAN_MODELS_DIR=./realesrgan/models
